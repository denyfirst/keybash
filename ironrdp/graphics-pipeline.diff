diff --git a/crates/ironrdp-web/src/gfx.rs b/crates/ironrdp-web/src/gfx.rs
new file mode 100644
index 0000000000000000000000000000000000000000..a353b9be0ca0418721894259f21286c19297daee
--- /dev/null
+++ b/crates/ironrdp-web/src/gfx.rs
@@ -0,0 +1,454 @@
+//! Keybash: the graphics pipeline, drawn by the page on the GPU.
+//!
+//! The pipeline client parses and decompresses the channel and decodes the bitmap codecs
+//! (planar, ClearCodec, RemoteFX and its progressive form). This handler turns every surface
+//! command into a compact record, in order. After each received frame the session hands the
+//! batch to the page's `__keybashGfx.apply`, which draws on GPU canvases and decodes Windows'
+//! H.264 with WebCodecs, so video reaches the screen without passing through the CPU.
+//!
+//! Record layout, little endian: one op byte, then the fields its writer below puts.
+
+use std::collections::BTreeMap;
+use std::sync::{Arc, Mutex, PoisonError};
+
+use ironrdp_core::{Decode as _, ReadCursor};
+use ironrdp_egfx::client::{BitmapUpdate, GraphicsPipelineHandler, Surface};
+use ironrdp_egfx::pdu::{
+    Avc420BitmapStream, Avc444BitmapStream, CacheToSurfacePdu, CapabilitiesV8Flags, CapabilitiesV10Flags,
+    CapabilitiesV81Flags, CapabilitiesV103Flags, CapabilitiesV104Flags, CapabilitiesV107Flags, CapabilitySet,
+    Codec1Type, EvictCacheEntryPdu, GfxPdu, MapSurfaceToScaledOutputPdu, PixelFormat, SolidFillPdu,
+    SurfaceToCachePdu, SurfaceToSurfacePdu, avc_to_annex_b, is_avc_format,
+};
+use ironrdp_pdu::geometry::ExclusiveRectangle;
+use tracing::{info, warn};
+
+const OP_RESET: u8 = 1;
+const OP_CREATE: u8 = 2;
+const OP_DELETE: u8 = 3;
+const OP_MAP: u8 = 4;
+const OP_FILL: u8 = 5;
+const OP_COPY: u8 = 6;
+const OP_TO_CACHE: u8 = 7;
+const OP_FROM_CACHE: u8 = 8;
+const OP_EVICT: u8 = 9;
+const OP_BITMAP: u8 = 10;
+const OP_AVC420: u8 = 11;
+const OP_AVC444: u8 = 12;
+const OP_END_FRAME: u8 = 13;
+const OP_MAP_SCALED: u8 = 14;
+const OP_NOTE: u8 = 15;
+const OP_CLOSE: u8 = 16;
+const OP_ALPHA: u8 = 17;
+
+/// Which H.264 the client offers Windows.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum GfxVideo {
+    /// Version 10 capabilities: Windows chooses AVC444 or AVC420 for the whole screen.
+    Avc444,
+    /// Version 8.1: AVC420 where Windows sees video, the lossless codecs elsewhere.
+    Avc420,
+    /// No H.264: RemoteFX progressive, ClearCodec and planar only.
+    Off,
+}
+
+impl GfxVideo {
+    pub(crate) fn from_name(name: &str) -> Option<Self> {
+        match name {
+            "avc444" => Some(Self::Avc444),
+            "avc420" => Some(Self::Avc420),
+            "off" => Some(Self::Off),
+            _ => None,
+        }
+    }
+
+    /// AVC420 and AVC444 to advertise.
+    pub(crate) fn avc(self) -> (bool, bool) {
+        match self {
+            Self::Avc444 => (true, true),
+            Self::Avc420 => (true, false),
+            Self::Off => (false, false),
+        }
+    }
+}
+
+/// Records waiting for the page, and whether the pipeline is drawing the screen.
+#[derive(Default)]
+pub(crate) struct GfxQueue {
+    pub(crate) records: Vec<u8>,
+    pub(crate) active: bool,
+}
+
+pub(crate) type SharedGfxQueue = Arc<Mutex<GfxQueue>>;
+
+pub(crate) fn take_records(queue: &SharedGfxQueue) -> (Vec<u8>, bool) {
+    let mut queue = queue.lock().unwrap_or_else(PoisonError::into_inner);
+    (core::mem::take(&mut queue.records), queue.active)
+}
+
+pub(crate) struct PageRenderer {
+    queue: SharedGfxQueue,
+    video: GfxVideo,
+    /// Surfaces without alpha get opaque pixels, as `put_image_data` stores alpha as given.
+    opaque: BTreeMap<u16, bool>,
+}
+
+impl PageRenderer {
+    pub(crate) fn new(queue: SharedGfxQueue, video: GfxVideo) -> Self {
+        Self {
+            queue,
+            video,
+            opaque: BTreeMap::new(),
+        }
+    }
+
+    fn write(&self, f: impl FnOnce(&mut Writer<'_>)) {
+        let mut queue = self.queue.lock().unwrap_or_else(PoisonError::into_inner);
+        f(&mut Writer(&mut queue.records));
+    }
+
+    fn note(&self, text: &str) {
+        info!(text, "graphics pipeline");
+        self.write(|w| {
+            w.u8(OP_NOTE);
+            w.bytes(text.as_bytes());
+        });
+    }
+}
+
+struct Writer<'a>(&'a mut Vec<u8>);
+
+impl Writer<'_> {
+    fn u8(&mut self, v: u8) {
+        self.0.push(v);
+    }
+    fn u16(&mut self, v: u16) {
+        self.0.extend_from_slice(&v.to_le_bytes());
+    }
+    fn u32(&mut self, v: u32) {
+        self.0.extend_from_slice(&v.to_le_bytes());
+    }
+    fn rect(&mut self, r: &ExclusiveRectangle) {
+        self.u16(r.left);
+        self.u16(r.top);
+        self.u16(r.right);
+        self.u16(r.bottom);
+    }
+    fn rects(&mut self, rects: &[ExclusiveRectangle]) {
+        self.u16(u16::try_from(rects.len()).unwrap_or(u16::MAX));
+        for r in rects.iter().take(usize::from(u16::MAX)) {
+            self.rect(r);
+        }
+    }
+    /// A u32 length, then the bytes.
+    fn bytes(&mut self, data: &[u8]) {
+        self.u32(u32::try_from(data.len()).unwrap_or(u32::MAX));
+        self.0.extend_from_slice(data);
+    }
+    /// H.264 as an Annex B byte stream, which WebCodecs reads without a description.
+    fn h264(&mut self, data: &[u8]) {
+        if is_avc_format(data) {
+            self.bytes(&avc_to_annex_b(data));
+        } else {
+            self.bytes(data);
+        }
+    }
+    fn avc420(&mut self, stream: &Avc420BitmapStream<'_>) {
+        self.rects(&stream.rectangles);
+        self.h264(stream.data);
+    }
+}
+
+impl GraphicsPipelineHandler for PageRenderer {
+    fn capabilities(&self) -> Vec<CapabilitySet> {
+        match self.video {
+            GfxVideo::Avc444 => vec![
+                CapabilitySet::V10_7 {
+                    flags: CapabilitiesV107Flags::SMALL_CACHE,
+                },
+                CapabilitySet::V10_6 {
+                    flags: CapabilitiesV104Flags::SMALL_CACHE,
+                },
+                CapabilitySet::V10_5 {
+                    flags: CapabilitiesV104Flags::SMALL_CACHE,
+                },
+                CapabilitySet::V10_4 {
+                    flags: CapabilitiesV104Flags::SMALL_CACHE,
+                },
+                CapabilitySet::V10_3 {
+                    flags: CapabilitiesV103Flags::empty(),
+                },
+                CapabilitySet::V10_2 {
+                    flags: CapabilitiesV10Flags::SMALL_CACHE,
+                },
+                CapabilitySet::V10 {
+                    flags: CapabilitiesV10Flags::SMALL_CACHE,
+                },
+                CapabilitySet::V8_1 {
+                    flags: CapabilitiesV81Flags::AVC420_ENABLED | CapabilitiesV81Flags::SMALL_CACHE,
+                },
+                CapabilitySet::V8 {
+                    flags: CapabilitiesV8Flags::SMALL_CACHE,
+                },
+            ],
+            GfxVideo::Avc420 => vec![
+                CapabilitySet::V8_1 {
+                    flags: CapabilitiesV81Flags::AVC420_ENABLED | CapabilitiesV81Flags::SMALL_CACHE,
+                },
+                CapabilitySet::V8 {
+                    flags: CapabilitiesV8Flags::SMALL_CACHE,
+                },
+            ],
+            GfxVideo::Off => vec![
+                CapabilitySet::V10_7 {
+                    flags: CapabilitiesV107Flags::SMALL_CACHE | CapabilitiesV107Flags::AVC_DISABLED,
+                },
+                CapabilitySet::V10_6 {
+                    flags: CapabilitiesV104Flags::SMALL_CACHE | CapabilitiesV104Flags::AVC_DISABLED,
+                },
+                CapabilitySet::V10_5 {
+                    flags: CapabilitiesV104Flags::SMALL_CACHE | CapabilitiesV104Flags::AVC_DISABLED,
+                },
+                CapabilitySet::V10_4 {
+                    flags: CapabilitiesV104Flags::SMALL_CACHE | CapabilitiesV104Flags::AVC_DISABLED,
+                },
+                CapabilitySet::V10_3 {
+                    flags: CapabilitiesV103Flags::AVC_DISABLED,
+                },
+                CapabilitySet::V10_2 {
+                    flags: CapabilitiesV10Flags::SMALL_CACHE | CapabilitiesV10Flags::AVC_DISABLED,
+                },
+                CapabilitySet::V10 {
+                    flags: CapabilitiesV10Flags::SMALL_CACHE | CapabilitiesV10Flags::AVC_DISABLED,
+                },
+                CapabilitySet::V8_1 {
+                    flags: CapabilitiesV81Flags::SMALL_CACHE,
+                },
+                CapabilitySet::V8 {
+                    flags: CapabilitiesV8Flags::SMALL_CACHE,
+                },
+            ],
+        }
+    }
+
+    fn on_capabilities_confirmed(&mut self, caps: &CapabilitySet) {
+        self.queue.lock().unwrap_or_else(PoisonError::into_inner).active = true;
+        self.note(&format!("confirmed {caps:?}, offered {:?}", self.video));
+    }
+
+    fn on_reset_graphics(&mut self, width: u32, height: u32) {
+        self.opaque.clear();
+        self.write(|w| {
+            w.u8(OP_RESET);
+            w.u32(width);
+            w.u32(height);
+        });
+    }
+
+    fn on_reset_graphics_rejected(&mut self, width: u32, height: u32) {
+        self.note(&format!("reset to {width}x{height} rejected"));
+    }
+
+    fn on_surface_created(&mut self, surface: &Surface) {
+        let opaque = surface.pixel_format == PixelFormat::XRgb;
+        self.opaque.insert(surface.id, opaque);
+        self.write(|w| {
+            w.u8(OP_CREATE);
+            w.u16(surface.id);
+            w.u16(surface.width);
+            w.u16(surface.height);
+            w.u8(u8::from(!opaque));
+        });
+    }
+
+    fn on_surface_deleted(&mut self, surface_id: u16) {
+        self.opaque.remove(&surface_id);
+        self.write(|w| {
+            w.u8(OP_DELETE);
+            w.u16(surface_id);
+        });
+    }
+
+    fn on_surface_mapped(&mut self, surface_id: u16, origin_x: u32, origin_y: u32) {
+        self.write(|w| {
+            w.u8(OP_MAP);
+            w.u16(surface_id);
+            w.u32(origin_x);
+            w.u32(origin_y);
+        });
+    }
+
+    fn on_map_surface_to_scaled_output(&mut self, pdu: &MapSurfaceToScaledOutputPdu) {
+        self.write(|w| {
+            w.u8(OP_MAP_SCALED);
+            w.u16(pdu.surface_id);
+            w.u32(pdu.output_origin_x);
+            w.u32(pdu.output_origin_y);
+            w.u32(pdu.target_width);
+            w.u32(pdu.target_height);
+        });
+    }
+
+    fn on_bitmap_updated(&mut self, update: &BitmapUpdate) {
+        let opaque = self.opaque.get(&update.surface_id).copied().unwrap_or(true);
+        let expected = usize::from(update.width) * usize::from(update.height) * 4;
+        if update.data.len() != expected {
+            warn!(len = update.data.len(), expected, "Bitmap update of the wrong size dropped");
+            return;
+        }
+        self.write(|w| {
+            w.u8(OP_BITMAP);
+            w.u16(update.surface_id);
+            w.rect(&update.destination_rectangle);
+            let start = w.0.len() + 4;
+            w.bytes(&update.data);
+            if opaque {
+                for alpha in w.0[start..].iter_mut().skip(3).step_by(4) {
+                    *alpha = 0xFF;
+                }
+            }
+        });
+    }
+
+    fn on_frame_complete(&mut self, frame_id: u32) {
+        self.write(|w| {
+            w.u8(OP_END_FRAME);
+            w.u32(frame_id);
+        });
+    }
+
+    fn on_close(&mut self) {
+        self.opaque.clear();
+        let mut queue = self.queue.lock().unwrap_or_else(PoisonError::into_inner);
+        queue.active = false;
+        queue.records.push(OP_CLOSE);
+    }
+
+    fn on_solid_fill(&mut self, pdu: &SolidFillPdu) {
+        self.write(|w| {
+            w.u8(OP_FILL);
+            w.u16(pdu.surface_id);
+            w.u8(pdu.fill_pixel.r);
+            w.u8(pdu.fill_pixel.g);
+            w.u8(pdu.fill_pixel.b);
+            w.u8(pdu.fill_pixel.xa);
+            w.rects(&pdu.rectangles);
+        });
+    }
+
+    fn on_surface_to_surface(&mut self, pdu: &SurfaceToSurfacePdu) {
+        self.write(|w| {
+            w.u8(OP_COPY);
+            w.u16(pdu.source_surface_id);
+            w.u16(pdu.destination_surface_id);
+            w.rect(&pdu.source_rectangle);
+            w.u16(u16::try_from(pdu.destination_points.len()).unwrap_or(u16::MAX));
+            for point in pdu.destination_points.iter().take(usize::from(u16::MAX)) {
+                w.u16(point.x);
+                w.u16(point.y);
+            }
+        });
+    }
+
+    fn on_surface_to_cache(&mut self, pdu: &SurfaceToCachePdu) {
+        self.write(|w| {
+            w.u8(OP_TO_CACHE);
+            w.u16(pdu.surface_id);
+            w.u16(pdu.cache_slot);
+            w.rect(&pdu.source_rectangle);
+        });
+    }
+
+    fn on_cache_to_surface(&mut self, pdu: &CacheToSurfacePdu) {
+        self.write(|w| {
+            w.u8(OP_FROM_CACHE);
+            w.u16(pdu.cache_slot);
+            w.u16(pdu.surface_id);
+            w.u16(u16::try_from(pdu.destination_points.len()).unwrap_or(u16::MAX));
+            for point in pdu.destination_points.iter().take(usize::from(u16::MAX)) {
+                w.u16(point.x);
+                w.u16(point.y);
+            }
+        });
+    }
+
+    fn on_evict_cache_entry(&mut self, pdu: &EvictCacheEntryPdu) {
+        self.write(|w| {
+            w.u8(OP_EVICT);
+            w.u16(pdu.cache_slot);
+        });
+    }
+
+    fn on_unhandled_pdu(&mut self, pdu: &GfxPdu) {
+        let GfxPdu::WireToSurface1(wire) = pdu else {
+            self.note(&format!("unhandled {}", pdu_name(pdu)));
+            return;
+        };
+        let mut cursor = ReadCursor::new(&wire.bitmap_data);
+        match wire.codec_id {
+            Codec1Type::Avc420 => match Avc420BitmapStream::decode(&mut cursor) {
+                Ok(stream) => self.write(|w| {
+                    w.u8(OP_AVC420);
+                    w.u16(wire.surface_id);
+                    w.rect(&wire.destination_rectangle);
+                    w.avc420(&stream);
+                }),
+                Err(error) => warn!(%error, "AVC420 stream dropped"),
+            },
+            Codec1Type::Avc444 | Codec1Type::Avc444v2 => match Avc444BitmapStream::decode(&mut cursor) {
+                Ok(stream) => self.write(|w| {
+                    w.u8(OP_AVC444);
+                    w.u16(wire.surface_id);
+                    w.u8(u8::from(wire.codec_id == Codec1Type::Avc444v2));
+                    w.u8(stream.encoding.bits());
+                    w.rect(&wire.destination_rectangle);
+                    w.avc420(&stream.stream1);
+                    match &stream.stream2 {
+                        Some(stream2) => {
+                            w.u8(1);
+                            w.avc420(stream2);
+                        }
+                        None => w.u8(0),
+                    }
+                }),
+                Err(error) => warn!(%error, "AVC444 stream dropped"),
+            },
+            Codec1Type::Alpha => self.write(|w| {
+                w.u8(OP_ALPHA);
+                w.u16(wire.surface_id);
+                w.rect(&wire.destination_rectangle);
+                w.bytes(&wire.bitmap_data);
+            }),
+            other => self.note(&format!("unhandled codec {other:?}")),
+        }
+    }
+}
+
+fn pdu_name(pdu: &GfxPdu) -> String {
+    let debug = format!("{pdu:?}");
+    debug.split(['(', ' ', '{']).next().unwrap_or("?").to_owned()
+}
+
+/// Gives the page a batch of records. When the page is behind, it returns a promise that
+/// settles once it caught up, and the session reads nothing more until then, so Windows
+/// slows down instead of the page falling further behind.
+pub(crate) async fn hand_to_page(canvas: &web_sys::HtmlCanvasElement, records: &[u8]) -> anyhow::Result<()> {
+    use anyhow::anyhow;
+    use wasm_bindgen::{JsCast as _, JsValue};
+
+    let page = js_sys::Reflect::get(&js_sys::global(), &JsValue::from_str("__keybashGfx"))
+        .map_err(|error| anyhow!("no page renderer: {error:?}"))?;
+    let apply = js_sys::Reflect::get(&page, &JsValue::from_str("apply"))
+        .map_err(|error| anyhow!("no page renderer: {error:?}"))?
+        .dyn_into::<js_sys::Function>()
+        .map_err(|_| anyhow!("the page renderer has no apply function"))?;
+    let bytes = js_sys::Uint8Array::from(records);
+    let result = apply
+        .call2(&page, canvas, &bytes)
+        .map_err(|error| anyhow!("page renderer failed: {error:?}"))?;
+    if let Some(promise) = result.dyn_ref::<js_sys::Promise>() {
+        wasm_bindgen_futures::JsFuture::from(promise.clone())
+            .await
+            .map_err(|error| anyhow!("page renderer failed: {error:?}"))?;
+    }
+    Ok(())
+}
